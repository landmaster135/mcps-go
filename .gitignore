#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
coverage.html

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

### macOS ###
# General
.DS_Store
.AppleDouble
.LSOverride
# Thumbnails
._*

### log ###
*.log

### Docker ###
# .dockerignore
# Dockerfile

### VSCode ###
.vscode/*

### setting files ###
.editorconfig
target*
env.yml
env.yaml
.clinerules
.clinerules/*

### Cloud Functions ###
.gcloudignore
mypkg/go.mod
mypkg/go.sum


